{
  "name": "pi-continuity-work-memory",
  "version": "1.0.0-rc.5",
  "description": "Managed repository workflow, branch-correct Pi continuity, evidence-backed checkpoints, scoped persistent memory, and Pi-native engineering skills.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "continuity",
    "workflow",
    "work-memory",
    "checkpoint",
    "agent-skills",
    "engineering-workflow"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ],
    "skills": [
      "./skills/audit-onboarding-proposal",
      "./skills/code-review",
      "./skills/codebase-design",
      "./skills/diagnosing-bugs",
      "./skills/domain-modeling",
      "./skills/encode-invariant",
      "./skills/grill-with-docs",
      "./skills/improve-harness",
      "./skills/onboard-repository",
      "./skills/tdd"
    ]
  },
  "files": [
    "dist",
    "skills",
    "workflow",
    "scripts/validate-install.mjs",
    "scripts/pi-version.mjs",
    "scripts/validate-provider.mjs",
    "scripts/validate-alpine-arm64.sh",
    "scripts/manage-user-install.mjs",
    "proof/ACCEPTANCE.md",
    "proof/RESULTS.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.1 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.1 <0.85.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.12.4",
    "typebox": "1.3.7"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:git-install": "tsc -p tsconfig.git-install.json",
    "test": "npm run build:test && node --test --test-concurrency=1 .test-build/test/*.test.js",
    "build:test": "tsc -p tsconfig.test.json",
    "validate:install": "node scripts/validate-install.mjs",
    "validate:git-install": "node scripts/validate-git-install.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "deploy:user": "node scripts/manage-user-install.mjs deploy",
    "remove:user": "node scripts/manage-user-install.mjs remove",
    "validate": "npm run clean && npm run typecheck && npm run build && npm test && npm run validate:install && npm run validate:git-install && npm run validate:release",
    "prepare": "npm run build:git-install",
    "prepack": "npm run clean && npm run build",
    "release": "node scripts/package-release.mjs"
  }
}
